# Copy this to .env locally, or paste each value into Render's environment settings.

GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# These two are the REST API keys (Supabase dashboard > Project Settings > API).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# This is a DIFFERENT thing from the two above — it's the raw Postgres connection
# string, not an API key. Get it from: Supabase dashboard > Project Settings >
# Database > Connection string. The direct connection (db.<ref>.supabase.co:5432)
# is IPv6-only unless you pay for the IPv4 add-on, which is likely why it failed
# and the Session Pooler one below worked instead.
# LEAVE THIS UNSET FOR LOCAL DEV. It's not just app data — it's whatsmeow's own
# crypto session store, read/written multiple times per message. Local sqlite is
# a sub-millisecond disk read each time; a cross-region Postgres pooler turns
# every one of those into a network round trip, which is what caused the 15+
# second reply delays. Only set this when deploying somewhere with an ephemeral
# filesystem (e.g. Render) where surviving a restart actually matters more than
# raw speed — and ideally pick a Supabase project region close to wherever the
# bot actually runs, not wherever you happened to create the project.
SESSION_DB_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Your own bare number/LID — no @server suffix. This is what makes admin
# commands (/enable, /disable, /status, /chats, /help) work, and ONLY from
# your private chat with the bot, never a group.
# Bootstrapping: leave this blank on first run, send the bot any private
# message, and look for a line like "[PRIVATE MESSAGE] from 142245760102636"
# in the console. That number is yours — put it here and restart.
OWNER_SENDER_ID=

RENDER_EXTERNAL_URL=https://your-service.onrender.com
ONEDRIVE_CLIENT_ID=...
ONEDRIVE_CLIENT_SECRET=...          # if confidential client
ONEDRIVE_REFRESH_TOKEN=...          # from one-time auth
ONEDRIVE_FOLDER=AgentLogs           # folder under your OneDrive root

# RAG knowledge base (pgvector). OneDrive full-access root for agency docs.
# Create sql/rag_schema.sql in Supabase, then owner /ingest agency | onedrive.
KNOWLEDGE_ONEDRIVE_ROOT=Documents/.aimojo
# Embeddings: gemini (default, uses GEMINI_API_KEY) or openai (OPENAI_API_KEY).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
# Optional OpenAI embeddings fallback
# OPENAI_API_KEY=

# Optional: higher-quality web_search (https://serper.dev free tier).
# Without this key Mojo falls back to DuckDuckGo.
SERPER_API_KEY=

# Optional: Supadata (https://supadata.ai) — best cloud path for Instagram /
# Facebook / TikTok transcripts (+ YouTube fallback). 100 free credits/mo.
# Without this key IG/FB fall back to yt-dlp ASR + caption/oEmbed "about".
SUPADATA_API_KEY=

# Optional: Netscape cookies.txt for yt-dlp (helps Instagram/Facebook/YouTube
# when cloud IPs are blocked). Export from browser extension, mount on host.
YTDLP_COOKIES=

# Linked-device activity keepalive. WhatsApp auto-logs out companion devices
# after ~30 days of *device* inactivity (primary-phone "Last active" stamp).
# Socket keep-alives alone do NOT refresh that stamp. We send Presence.AVAILABLE
# on connect and every N hours. Default 6. Set 0 to disable. Min effective 0.5.
PRESENCE_KEEPALIVE_HOURS=6

# ---------------------------------------------------------------------------
# Gmail outbound (job apply / cover letter / collab email) — owner-only tools
# draft_email + send_email. OAuth2 refresh token (same idea as OneDrive).
# One-time setup: Google Cloud Console → OAuth client (Desktop or Web) →
# consent screen with scope https://www.googleapis.com/auth/gmail.send →
# exchange auth code for refresh_token (see README / ops notes).
# ---------------------------------------------------------------------------
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=you@gmail.com
# Resume PDF for attachments (pick one):
# RESUME_PDF_PATH=/path/on/host/M_Zaheer_Resume.pdf
# RESUME_ONEDRIVE_PATH=Documents/Resume/M_Zaheer_Resume.pdf
# RESUME_FILENAME=Muhammad_Zaheeruddin_Resume.pdf


# Session cloud vs local detection (uploads to Supabase Storage).
# Render auto-detects via RENDER / RENDER_EXTERNAL_URL / RENDER_SERVICE_ID.
# Override if needed:
#   FORCE_CLOUD_SESSION=1  → always enable session upload/download
#   LOCAL_MODE=1           → always disable (laptop safety; never touch prod bucket)
# FORCE_CLOUD_SESSION=1
# LOCAL_MODE=1